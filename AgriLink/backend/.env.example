PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/agrilink
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
ADMIN_NAME=AgriLink Administrator
ADMIN_EMAIL=admin@agriconnect.in
ADMIN_PASSWORD=ChangeThisAdminPassword!
OTP_EXPIRES_MINUTES=5
# Configure SMTP to send real email OTPs. Without SMTP, OTP is logged only in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AgriLink <no-reply@agriconnect.in>
# Optional Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
